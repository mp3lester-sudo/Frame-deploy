# Copy this file to .env.local (for local dev) and set the same values as
# project env vars in Vercel for production. NEXT_RUNTIME, NODE_ENV,
# VERCEL_ENV, and VERCEL_URL are provided automatically by the platform and
# don't need to be set here.

# --- Supabase ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key -- server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
# Optional -- Auteur tier checkout is hidden ("Coming soon") until this is set.
STRIPE_AUTEUR_PRICE_ID=

# --- TMDB / OMDB / OpenAI (catalogue ingestion + enrichment) -----------
TMDB_API_KEY=
OMDB_API_KEY=
OPENAI_API_KEY=

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Web push (VAPID) ----------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Monitoring / analytics ------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Admin / cron ----------------------------------------------------------
# Comma-separated list of email addresses granted access to /admin.
ADMIN_EMAILS=
# Shared secret required in the Authorization header of Vercel cron requests
# (see vercel.json) so the cron routes can't be triggered by anyone else.
CRON_SECRET=
