<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Marquee</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Required because the web content's avatar upload (settings ->
	     profile photo) uses a plain <input type="file"> which WKWebView
	     turns into the native "Take Photo / Choose from Library" sheet.
	     Without these two keys, tapping "Take Photo" crashes the app
	     outright, and "Choose from Library" silently fails on some iOS
	     versions -- and App Review flags the missing purpose strings
	     regardless of whether a tester happens to trigger the crash. -->
	<key>NSCameraUsageDescription</key>
	<string>Marquee uses your camera so you can take a new profile photo.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Marquee uses your photo library so you can choose a profile photo.</string>
	<!-- Required because the home page's weather widget calls
	     navigator.geolocation.getCurrentPosition() to show local weather.
	     Without this key the permission prompt can't be shown at all, so
	     the request just fails and App Review flags the missing purpose
	     string. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Marquee uses your location to show local weather on your home page.</string>
	<!-- Declares this app only uses standard HTTPS/TLS (via the WebView
	     loading the production site) with no proprietary/non-exempt
	     encryption. Without this key, App Store Connect asks the export
	     compliance question in the web UI on every single build upload;
	     declaring it here answers that automatically, every time. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
